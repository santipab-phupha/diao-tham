# Copy to .env.local. Firebase Web config identifies your app; never paste a
# service-account private key or a production Google Cloud secret here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Public reCAPTCHA Enterprise score-based site key, registered in Firebase App Check.
VITE_APPCHECK_SITE_KEY=
# Local development ONLY: an already-registered App Check debug token.
# Keep .env.local private. Never commit or ship a debug token in production.
VITE_APPCHECK_DEBUG_TOKEN=

# Current Firebase AI Logic hybrid default; check model availability in your project.
VITE_FIREBASE_CLOUD_MODEL=gemini-3.5-flash-lite

# Turn on only after Google sign-in is configured in Firebase Authentication.
VITE_GOOGLE_SIGN_IN_ENABLED=false

# Optional Google Calendar Web OAuth client ID for the pre-sign-in setup.
VITE_GOOGLE_CLIENT_ID=
